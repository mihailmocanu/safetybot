SAMSARA_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
POLL_INTERVAL_SECONDS=60
# Pe Railway poate fi false până introduci tokenurile și ID-ul grupului.
BOT_ENABLED=true
# Regula directă viteză > limita locală; necesită Read Readings și Read Assets.
# Activează numai după verificarea accesului și datelor organizației.
LIVE_SPEEDING_ENABLED=false
# Verificare read-only a accesului Readings/Assets la pornire, fără afișarea datelor.
SPEEDING_API_CHECK=false

COMPANY_NAME=IDS Transportation
TIMEZONE=America/New_York
DATABASE_PATH=data/safety.sqlite3
# Railway: referință către URL-ul privat al serviciului Postgres.
# Gol = SQLite local. Obligatoriu pe Railway.
DATABASE_URL=
# Prima pornire: importă evenimente actualizate în ultimele 24 ore.
# După prima pornire se folosește cursorul persistent, indiferent de această valoare.
INITIAL_LOOKBACK_HOURS=24
SAMSARA_BASE_URL=https://api.samsara.com
# Opțional: cheia Base64 din Settings > Webhooks. Gol = polling fără webhook.
SAMSARA_WEBHOOK_SECRET=
WEBHOOK_PORT=8080
